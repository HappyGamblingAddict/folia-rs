# Example runtime configuration. Copy this file to server.properties before
# running the server; the real server.properties is ignored by git.
# Empty or 0.0.0.0 = all IPv4 interfaces. Use :: for IPv6-only.
# On this machine localhost resolves to ::1 first; connect with 127.0.0.1 or the LAN IP.
server-ip=
server-port=25565
motd=Folia-RS | Rust core
max-players=20
# Set true to require Mojang session authentication.
online-mode=false
level-name=world
view-distance=10
simulation-distance=10
enable-command-block=false
allow-flight=false
hardcore=false
pvp=true
white-list=false
difficulty=easy
gamemode=survival
spawn-protection=16
